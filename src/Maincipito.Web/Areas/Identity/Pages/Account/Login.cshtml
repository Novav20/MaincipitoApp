@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "/Pages/Shared/_LayoutLogin.cshtml";
}

<div class="row justify-content-center align-items-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0"><i class="fas fa-sign-in-alt"></i> Acceso a la Plataforma</h4>
            </div>
            <div class="card-body p-4">
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Input.Email" class="form-label font-weight-bold">Correo Electrónico</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            </div>
                            <input asp-for="Input.Email" class="form-control" placeholder="ejemplo@maincipito.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Password" class="form-label font-weight-bold">Contraseña</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            </div>
                            <input asp-for="Input.Password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-group form-check mb-3">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label class="form-check-label" asp-for="Input.RememberMe">Recordar mi sesión</label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-block py-2">
                            <i class="fas fa-key"></i> Iniciar Sesión
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3">
                <span>¿No tiene una cuenta? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Regístrese aquí</a></span>
            </div>
        </div>
    </div>

    <div class="col-md-5 d-none d-md-block text-center pl-lg-5">
        <img src="~/img/content_hub-happy_drivers-heart_icon.svg" alt="Hospitalización en Casa" width="220" height="220" class="mb-3 img-fluid">
        <h3 class="text-primary font-weight-bold">Hospitalización en Casa</h3>
        <p class="text-muted font-italic">Gestión clínica, asignación de personal médico y monitoreo de pacientes en casa.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}