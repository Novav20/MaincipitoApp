@page
@model RegisterModel
@{
    ViewData["Title"] = "Registro de Usuario";
    Layout = "/Pages/Shared/_LayoutLogin.cshtml";
}

<div class="row justify-content-center align-items-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0"><i class="fas fa-user-plus"></i> Crear Nueva Cuenta</h4>
            </div>
            <div class="card-body p-4">
                <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Input.Email" class="form-label font-weight-bold">Correo Electrónico</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            </div>
                            <input asp-for="Input.Email" class="form-control" placeholder="usuario@maincipito.com" />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.Password" class="form-label font-weight-bold">Contraseña</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            </div>
                            <input asp-for="Input.Password" class="form-control" placeholder="Mínimo 6 caracteres" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label font-weight-bold">Confirmar Contraseña</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-check-double"></i></span>
                            </div>
                            <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Repita la contraseña" />
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-block py-2">
                            <i class="fas fa-user-check"></i> Registrarse
                        </button>
                    </div>
                </form>
            </div>
            <div class="card-footer bg-light text-center py-3">
                <span>¿Ya tiene una cuenta registrada? <a asp-page="./Login">Inicie sesión aquí</a></span>
            </div>
        </div>
    </div>

    <div class="col-md-5 d-none d-md-block text-center pl-lg-5">
        <img src="~/img/content_hub-happy_drivers-heart_icon.svg" alt="Hospitalización en Casa" width="220" height="220" class="mb-3 img-fluid">
        <h3 class="text-primary font-weight-bold">Únase a la Plataforma</h3>
        <p class="text-muted font-italic">Acceda al sistema de administración hospitalaria y gestión de historias clínicas.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}