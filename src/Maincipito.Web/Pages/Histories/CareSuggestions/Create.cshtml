@page "{historyId:int}"
@model Maincipito.Web.Pages.Histories.CareSuggestions.CreateModel

@{
    ViewData["Title"] = "Agregar Sugerencia de Cuidado";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a asp-page="/Histories/Details" asp-route-id="@Model.History.Id" class="btn btn-secondary">Volver a la Historia</a>
</div>

@if (Model.Patient is not null)
{
    <div class="alert alert-info">
        <strong>Paciente:</strong> @Model.Patient.Name @Model.Patient.Surname (ID: @Model.Patient.Id)
    </div>
}

<div class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">Historia Clínica #@Model.History.Id</h5>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Diagnóstico</dt>
            <dd class="col-sm-10">@Model.History.Diagnosis</dd>

            <dt class="col-sm-2">Entorno</dt>
            <dd class="col-sm-10">@Model.History.Environment</dd>
        </dl>
    </div>
</div>

<h4>Sugerencias Registradas</h4>
<table class="table table-striped table-bordered mb-4">
    <thead class="thead-light">
        <tr>
            <th style="width: 25%;">Fecha y Hora</th>
            <th>Descripción</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.History.Suggestions.Count == 0)
    {
        <tr>
            <td colspan="2" class="text-center text-muted">No hay sugerencias registradas previamente.</td>
        </tr>
    }
    else
    {
        @foreach (var item in Model.History.Suggestions)
        {
            <tr>
                <td>@item.DateTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.Description</td>
            </tr>
        }
    }
    </tbody>
</table>

<h4>Nueva Sugerencia</h4>
<div class="row">
    <div class="col-md-8">
        <form method="post" asp-route-historyId="@Model.History.Id">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="CareSuggestion.Description" class="control-label">Descripción de la sugerencia</label>
                <textarea asp-for="CareSuggestion.Description" class="form-control" rows="3" placeholder="Ingrese el cuidado o instrucción médica recomendada..."></textarea>
                <span asp-validation-for="CareSuggestion.Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar Sugerencia" class="btn btn-primary" />
                <a asp-page="/Histories/Details" asp-route-id="@Model.History.Id" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}