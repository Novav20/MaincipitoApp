@page "{id:int}"
@model Maincipito.Web.Pages.Histories.CareSuggestions.EditModel

@{
    ViewData["Title"] = "Editar Sugerencia de Cuidado";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CareSuggestion.Id" />
            <input type="hidden" asp-for="CareSuggestion.DateTime" />
            
            <div class="form-group mb-3">
                <label asp-for="CareSuggestion.Description" class="control-label">Descripción</label>
                <textarea asp-for="CareSuggestion.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="CareSuggestion.Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Guardar cambios" class="btn btn-primary" />
                <a class="btn btn-secondary" asp-page="./Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}