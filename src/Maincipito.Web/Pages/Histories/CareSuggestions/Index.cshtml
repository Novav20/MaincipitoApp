@page
@model Maincipito.Web.Pages.Histories.CareSuggestions.IndexModel

@{
    ViewData["Title"] = "Listado de Sugerencias de Cuidado";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
</div>

<table class="table table-hover table-striped">
    <thead class="thead-light">
        <tr>
            <th>ID</th>
            <th>Fecha y Hora</th>
            <th>Descripción</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
@if (Model.CareSuggestions.Count == 0)
{
    <tr>
        <td colspan="4" class="text-center text-muted">No se encontraron sugerencias de cuidado registradas.</td>
    </tr>
}
else
{
    @foreach (var item in Model.CareSuggestions)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.DateTime.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@item.Description</td>
            <td class="text-center">
                <a class="btn btn-sm btn-outline-warning" asp-page="./Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-sm btn-outline-info" asp-page="./Details" asp-route-id="@item.Id">Detalles</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@item.Id">Borrar</a>
            </td>
        </tr>
    }
}
    </tbody>
</table>