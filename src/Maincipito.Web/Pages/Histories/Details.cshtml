@page "{id:int}"
@model Maincipito.Web.Pages.Histories.DetailsModel

@{
    ViewData["Title"] = "Historia Clínica";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <div>
        <a class="btn btn-warning" asp-page="./Edit" asp-route-id="@Model.History.Id">Editar Historia</a>
        @if (Model.Patient is not null)
        {
            <a class="btn btn-secondary" asp-page="/Patients/Details" asp-route-id="@Model.Patient.Id">Volver al paciente</a>
        }
        else
        {
            <a class="btn btn-secondary" asp-page="./Index">Volver al listado</a>
        }
    </div>
</div>

@if (Model.Patient is not null)
{
    <div class="alert alert-info">
        <strong>Paciente vinculado:</strong> 
        <a asp-page="/Patients/Details" asp-route-id="@Model.Patient.Id" class="alert-link font-weight-bold">
            @Model.Patient.Name @Model.Patient.Surname (ID: @Model.Patient.Id)
        </a>
    </div>
}

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Diagnóstico y Entorno Clínico</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.History.Id)</dt>
            <dd class="col-sm-9">@Model.History.Id</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.History.Diagnosis)</dt>
            <dd class="col-sm-9">@Model.History.Diagnosis</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.History.Environment)</dt>
            <dd class="col-sm-9">@Model.History.Environment</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Sugerencias de Cuidado</h5>
        <a class="btn btn-sm btn-primary" asp-page="./CareSuggestions/Create" asp-route-historyId="@Model.History.Id">
            <i class="fas fa-plus"></i> Agregar Sugerencia
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="thead-light">
                <tr>
                    <th style="width: 25%;">Fecha y Hora</th>
                    <th>Descripción de la Sugerencia</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.History.Suggestions.Count == 0)
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">No se han registrado sugerencias de cuidado para esta historia.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.History.Suggestions)
                {
                    <tr>
                        <td>@item.DateTime.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Description</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>