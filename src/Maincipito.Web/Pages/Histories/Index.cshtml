@page
@model Maincipito.Web.Pages.Histories.IndexModel

@{
    ViewData["Title"] = "Historias Clínicas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-page="Create">
        <i class="fas fa-file-medical"></i> Registrar nueva historia
    </a>
</div>

<table class="table table-hover table-striped">
    <thead class="thead-light">
        <tr>
            <th>ID</th>
            <th>Diagnóstico</th>
            <th>Entorno</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
@if (Model.Histories.Count == 0)
{
    <tr>
        <td colspan="4" class="text-center text-muted">No se encontraron historias clínicas registradas.</td>
    </tr>
}
else
{
    @foreach (var item in Model.Histories)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Diagnosis</td>
            <td>@item.Environment</td>
            <td class="text-center">
                <a class="btn btn-sm btn-outline-warning" asp-page="./Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-sm btn-outline-info" asp-page="./Details" asp-route-id="@item.Id">Detalles</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@item.Id">Borrar</a>
            </td>
        </tr>
    }
}
    </tbody>
</table>