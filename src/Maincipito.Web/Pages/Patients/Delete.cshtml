@page "{id:int}"
@model Maincipito.Web.Pages.Patients.DeleteModel

@{
    ViewData["Title"] = "Borrar Paciente";
}

<h1>@ViewData["Title"]</h1>
<h3 class="text-danger">¿Está seguro de que desea eliminar este paciente?</h3>

<div>
    <h4>@Model.Patient.Name @Model.Patient.Surname</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient.Id)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Patient.Id)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Patient.Name)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient.Surname)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Patient.Surname)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient.Cellphone)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Patient.Cellphone)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient.City)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Patient.City)</dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Patient.Id" />
        <input type="submit" value="Confirmar Eliminación" class="btn btn-danger" /> |
        <a class="btn btn-secondary" asp-page="./Index">Cancelar</a>
    </form>
</div>