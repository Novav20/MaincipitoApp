@page "{id:int}"
@model Maincipito.Web.Pages.Patients.DetailsModel

@{
    ViewData["Title"] = "Detalles del Paciente";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <div>
        <a class="btn btn-warning" asp-page="./Edit" asp-route-id="@Model.Patient.Id">Editar Datos</a>
        <a class="btn btn-secondary" asp-page="./Index">Volver al listado</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">@Model.Patient.Name @Model.Patient.Surname (ID: @Model.Patient.Id)</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient.Gender)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Patient.Gender)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient.Cellphone)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Patient.Cellphone)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient.DateOfBirth)</dt>
            <dd class="col-sm-9">@Model.Patient.DateOfBirth.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Patient.Address)</dt>
            <dd class="col-sm-9">@Model.Patient.Address, @Model.Patient.City</dd>

            <dt class="col-sm-3">Médico Asignado</dt>
            <dd class="col-sm-9">
                @if (Model.Patient.Doctor is not null)
                {
                    <span class="badge badge-success">@Model.Patient.Doctor.Name @Model.Patient.Doctor.Surname (@Model.Patient.Doctor.MedicalSpecialty)</span>
                    <a asp-page="./AssignDoctor/AssignDoctor" asp-route-id="@Model.Patient.Id" class="btn btn-sm btn-outline-warning ml-2">Reasignar</a>
                }
                else
                {
                    <span class="text-muted">Sin médico asignado.</span>
                    <a asp-page="./AssignDoctor/AssignDoctor" asp-route-id="@Model.Patient.Id" class="btn btn-sm btn-outline-primary ml-2">Asignar Médico</a>
                }
            </dd>

            <dt class="col-sm-3">Familiar de Contacto</dt>
            <dd class="col-sm-9">
                @if (Model.Patient.Relative is not null)
                {
                    <a asp-page="/Relatives/Details" asp-route-id="@Model.Patient.Relative.Id" class="text-info font-weight-bold">
                        @Model.Patient.Relative.Name @Model.Patient.Relative.Surname (@Model.Patient.Relative.Relationship)
                    </a>
                }
                else
                {
                    <span class="text-muted">Sin familiar asignado.</span>
                    <a asp-page="/Relatives/Create" asp-route-patientId="@Model.Patient.Id" class="btn btn-sm btn-outline-primary ml-2">Asignar Familiar</a>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Signos Vitales y Mediciones</h5>
        <div>
            <a class="btn btn-sm btn-primary" asp-page="/VitalSigns/Create" asp-route-patientId="@Model.Patient.Id">Registrar Signo Vital</a>
            @if (Model.Patient.History is not null)
            {
                <a class="btn btn-sm btn-info" asp-page="/Histories/Details" asp-route-id="@Model.Patient.History.Id">Historia Clínica</a>
            }
            else
            {
                <a class="btn btn-sm btn-outline-info" asp-page="/Histories/Create" asp-route-patientId="@Model.Patient.Id">Crear Historia Clínica</a>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead class="thead-light">
                <tr>
                    <th>Signo Vital</th>
                    <th>Valor</th>
                    <th>Fecha y Hora</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Patient.VitalSigns.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">No hay registros de signos vitales para este paciente.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Patient.VitalSigns)
                {
                    <tr>
                        <td>@item.Sign</td>
                        <td>@item.Value</td>
                        <td>@item.DateTime.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>