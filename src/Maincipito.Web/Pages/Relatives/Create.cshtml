@page "{patientId:int?}"
@model Maincipito.Web.Pages.Relatives.CreateModel

@{
    ViewData["Title"] = Model.Patient is not null ? "Asignar Familiar a Paciente" : "Registrar Familiar";
}

<h1>@ViewData["Title"]</h1>

@if (Model.Patient is not null)
{
    <div class="alert alert-info">
        <strong>Paciente asignado:</strong> @Model.Patient.Name @Model.Patient.Surname (ID: @Model.Patient.Id)
    </div>
}

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PatientId" />
            
            <div class="form-group">
                <label asp-for="Relative.Name" class="control-label"></label>
                <input asp-for="Relative.Name" class="form-control" />
                <span asp-validation-for="Relative.Name" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Relative.Surname" class="control-label"></label>
                <input asp-for="Relative.Surname" class="form-control" />
                <span asp-validation-for="Relative.Surname" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Relative.Gender" class="control-label"></label>
                <select asp-for="Relative.Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-control">
                    <option value="">-- Seleccionar Género --</option>
                </select>
                <span asp-validation-for="Relative.Gender" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Relative.Relationship" class="control-label"></label>
                <input asp-for="Relative.Relationship" class="form-control" />
                <span asp-validation-for="Relative.Relationship" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="Relative.Cellphone" class="control-label"></label>
                <input asp-for="Relative.Cellphone" class="form-control" />
                <span asp-validation-for="Relative.Cellphone" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Relative.Email" class="control-label"></label>
                <input asp-for="Relative.Email" class="form-control" />
                <span asp-validation-for="Relative.Email" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a class="btn btn-secondary" asp-page="./Index">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}