@page "{id:int}"
@model Maincipito.Web.Pages.Relatives.DeleteModel

@{
    ViewData["Title"] = "Borrar Familiar";
}

<h1>@ViewData["Title"]</h1>
<h3 class="text-danger">¿Está seguro de que desea eliminar este familiar?</h3>

<div>
    <h4>@Model.Relative.Name @Model.Relative.Surname</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Relative.Id)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Relative.Id)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Relative.Name)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Relative.Name)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Relative.Surname)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Relative.Surname)</dd>

        <dt class="col-sm-3">Parentesco</dt>
        <dd class="col-sm-9">@Model.Relative.Relationship</dd>

        <dt class="col-sm-3">Teléfono</dt>
        <dd class="col-sm-9">@Model.Relative.Cellphone</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Relative.Email</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Relative.Id" />
        <input type="submit" value="Confirmar Eliminación" class="btn btn-danger" /> |
        <a class="btn btn-secondary" asp-page="./Index">Cancelar</a>
    </form>
</div>