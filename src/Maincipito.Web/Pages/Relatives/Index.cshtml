@page
@model Maincipito.Web.Pages.Relatives.IndexModel

@{
    ViewData["Title"] = "Familiares Registrados";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-page="Create">
        <i class="fas fa-user-plus"></i> Registrar nuevo familiar
    </a>
</div>

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="SearchString" value="@Model.SearchString" class="form-control" placeholder="Buscar por nombre, apellido, parentesco o email..." />
        <div class="input-group-append">
            <button type="submit" class="btn btn-outline-secondary">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchString))
            {
                <a asp-page="./Index" class="btn btn-outline-danger">Limpiar</a>
            }
        </div>
    </div>
</form>

<table class="table table-hover table-striped">
    <thead class="thead-light">
        <tr>
            <th>Nombre(s)</th>
            <th>Apellido(s)</th>
            <th>Parentesco</th>
            <th>Teléfono</th>
            <th>Correo Electrónico</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
@if (Model.Relatives.Count == 0)
{
    <tr>
        <td colspan="6" class="text-center text-muted">No se encontraron familiares registrados.</td>
    </tr>
}
else
{
    @foreach (var item in Model.Relatives)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Surname</td>
            <td>@item.Relationship</td>
            <td>@item.Cellphone</td>
            <td>@item.Email</td>
            <td class="text-center">
                <a class="btn btn-sm btn-outline-warning" asp-page="./Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-sm btn-outline-info" asp-page="./Details" asp-route-id="@item.Id">Detalles</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@item.Id">Borrar</a>
            </td>
        </tr>
    }
}
    </tbody>
</table>