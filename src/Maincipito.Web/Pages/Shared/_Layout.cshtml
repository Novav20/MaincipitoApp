<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospitalización en Casa</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    
    <!-- Custom Site Styles & Design Tokens -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/img/content_hub-happy_drivers-heart_icon.svg" alt="Logo" width="36" height="36" class="mr-2" />
                    Hospitalización en Casa
                </a>
                
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mr-auto">
                        <li class="nav-item">
                            <a class="nav-link font-weight-bold" asp-area="" asp-page="/Patients/Index">
                                <i class="fas fa-user-injured text-primary"></i> Pacientes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link font-weight-bold" asp-area="" asp-page="/Doctors/Index">
                                <i class="fas fa-user-md text-primary"></i> Médicos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link font-weight-bold" asp-area="" asp-page="/Relatives/Index">
                                <i class="fas fa-users text-primary"></i> Familiares
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link font-weight-bold" asp-area="" asp-page="/VitalSigns/Index">
                                <i class="fas fa-heartbeat text-danger"></i> Signos Vitales
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link font-weight-bold" asp-area="" asp-page="/Histories/Index">
                                <i class="fas fa-file-medical text-primary"></i> Historias Clínicas
                            </a>
                        </li>
                    </ul>

                    <!-- Componente Modular de Autenticación / Identity -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-3 mt-auto">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year - Hospitalización en Casa — Plataforma de Gestión y Monitoreo Ambulatorio.</span>
            <div class="mt-1">
                <a class="text-muted" asp-area="" asp-page="/Privacy">Política de Privacidad</a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>