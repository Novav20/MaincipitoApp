<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospitalización en Casa</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center font-weight-bold text-primary" asp-area="" asp-page="/Index">
                    <img src="~/img/content_hub-happy_drivers-heart_icon.svg" alt="Logo" width="40" height="40" class="mr-2">
                    Hospitalización en Casa
                </a>
                <div class="navbar-nav ml-auto">
                    <a class="btn btn-sm btn-outline-primary mr-2" asp-area="Identity" asp-page="/Account/Login">
                        <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
                    </a>
                    <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Register">
                        <i class="fas fa-user-plus"></i> Registrarse
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white text-muted py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; @DateTime.Now.Year - Hospitalización en Casa — Sistema de Gestión Clínica</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>