@page "{id:int}"
@model Maincipito.Web.Pages.VitalSigns.DeleteModel

@{
    ViewData["Title"] = "Borrar Signo Vital";
}

<h1>@ViewData["Title"]</h1>
<h3 class="text-danger">¿Está seguro de que desea eliminar esta medición?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Signo Vital</dt>
        <dd class="col-sm-9">@Model.VitalSign.Sign</dd>

        <dt class="col-sm-3">Valor</dt>
        <dd class="col-sm-9"><strong>@Model.VitalSign.Value</strong></dd>

        <dt class="col-sm-3">Fecha y Hora</dt>
        <dd class="col-sm-9">@Model.VitalSign.DateTime.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="VitalSign.Id" />
        <input type="submit" value="Confirmar Eliminación" class="btn btn-danger" /> |
        <a class="btn btn-secondary" asp-page="./Index">Cancelar</a>
    </form>
</div>