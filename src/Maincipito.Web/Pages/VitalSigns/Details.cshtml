@page "{id:int}"
@model Maincipito.Web.Pages.VitalSigns.DetailsModel

@{
    ViewData["Title"] = "Detalles del Signo Vital";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <div>
        <a class="btn btn-warning" asp-page="./Edit" asp-route-id="@Model.VitalSign.Id">Editar</a>
        <a class="btn btn-secondary" asp-page="./Index">Volver al listado</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Medición #@Model.VitalSign.Id</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Signo Vital</dt>
            <dd class="col-sm-9">@Model.VitalSign.Sign</dd>

            <dt class="col-sm-3">Valor</dt>
            <dd class="col-sm-9"><strong>@Model.VitalSign.Value</strong></dd>

            <dt class="col-sm-3">Fecha y Hora</dt>
            <dd class="col-sm-9">@Model.VitalSign.DateTime.ToString("dd/MM/yyyy HH:mm:ss")</dd>
        </dl>
    </div>
</div>