@page "{id:int}"
@model Maincipito.Web.Pages.VitalSigns.EditModel

@{
    ViewData["Title"] = "Editar Signo Vital";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="VitalSign.Id" />
            
            <div class="form-group">
                <label asp-for="VitalSign.Sign" class="control-label"></label>
                <select asp-for="VitalSign.Sign" asp-items="Html.GetEnumSelectList<Sign>()" class="form-control"></select>
                <span asp-validation-for="VitalSign.Sign" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="VitalSign.Value" class="control-label"></label>
                <input asp-for="VitalSign.Value" class="form-control" />
                <span asp-validation-for="VitalSign.Value" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="VitalSign.DateTime" class="control-label"></label>
                <input asp-for="VitalSign.DateTime" class="form-control" />
                <span asp-validation-for="VitalSign.DateTime" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar cambios" class="btn btn-primary" />
                <a class="btn btn-secondary" asp-page="./Index">Volver al listado</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}